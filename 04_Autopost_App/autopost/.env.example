# ---- ບອກຕໍ່ຄວາມຮູ້ Auto Post ----
AUTOPOST_PUBLIC_BASE_URL=https://ainsteinx.com
AUTOPOST_FERNET_KEY=            # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AUTOPOST_PAIR_CODE=             # ລະຫັດລັບສັ້ນໆ ທີ່ພິມໃນແຊັດ: pair <ລະຫັດ>

# YouTube (Google Cloud Console → OAuth client "Web application")
AUTOPOST_GOOGLE_CLIENT_ID=
AUTOPOST_GOOGLE_CLIENT_SECRET=
AUTOPOST_YOUTUBE_PRIVACY=public

# Facebook Page + WhatsApp (Meta app)
AUTOPOST_META_APP_ID=
AUTOPOST_META_APP_SECRET=
AUTOPOST_FB_PAGE_ID=

# TikTok (developers.tiktok.com → Content Posting API)
AUTOPOST_TIKTOK_CLIENT_KEY=
AUTOPOST_TIKTOK_CLIENT_SECRET=
AUTOPOST_TIKTOK_PRIVACY=SELF_ONLY

# LINE Messaging API
AUTOPOST_LINE_CHANNEL_SECRET=
AUTOPOST_LINE_CHANNEL_ACCESS_TOKEN=

# WhatsApp Cloud API
AUTOPOST_WA_PHONE_NUMBER_ID=
AUTOPOST_WA_ACCESS_TOKEN=
AUTOPOST_WA_VERIFY_TOKEN=
AUTOPOST_WA_DAILY_TEMPLATE=
AUTOPOST_WA_TEMPLATE_LANG=lo
